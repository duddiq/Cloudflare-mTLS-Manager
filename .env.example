# Cloudflare API Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Session / Authentication (Mock for local dev)
MOCK_USER_EMAIL=test@example.com

# Admin account
ADMIN_USER=test@example.com

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Encryption secret to encrypt email sender API key. This value must be the same in all locations.
ENCRYPTION_SECRET=

# Security Rule for mTLS enforcement (auto-discovered, no configuration needed)
# Optional overrides if auto-discovery doesn't work:
# CLOUDFLARE_MTLS_RULESET_ID=your_ruleset_id
# CLOUDFLARE_MTLS_RULE_ID=your_rule_id